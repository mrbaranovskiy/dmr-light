{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/dmr/event-v1",
  "title": "DMR receiver event v1",
  "type": "object",
  "required": ["schema_version", "sequence", "type", "capture_id", "rf_sample_index", "rf_time_seconds", "track", "slot", "session_id", "data"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "sequence": {"type": "integer", "minimum": 0},
    "type": {"enum": ["capture_info", "sync_acquired", "sync_lost", "burst", "symbols", "pdu", "control", "data_header", "diagnostic", "call_start", "call_update", "call_end", "vocoder_frame", "erasure", "talker_alias", "location", "data_packet", "text_message"]},
    "capture_id": {"type": "string"},
    "rf_sample_index": {"type": "integer", "minimum": 0},
    "rf_time_seconds": {"type": "number", "minimum": 0},
    "track": {"enum": [-1, 0, 1]},
    "slot": {"enum": [null, 1, 2]},
    "session_id": {"type": ["string", "null"]},
    "data": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"type": {"const": "vocoder_frame"}}},
      "then": {
        "properties": {
          "session_id": {"type": "string"},
          "data": {
            "required": ["burst_id", "superframe_phase", "frame_index_in_burst", "frame_sequence", "playout_offset_ms", "duration_ms", "representation", "bit_length", "payload_hex", "privacy_status", "metadata_revision", "channel_decode_valid", "corrected_bits", "voice_crc_available", "erasure", "ambe49_hex", "ambe49_status"],
            "properties": {
              "burst_id": {"type": "integer", "minimum": 1},
              "superframe_phase": {"enum": ["A", "B", "C", "D", "E", "F"]},
              "frame_index_in_burst": {"enum": [0, 1, 2]},
              "frame_sequence": {"type": "integer", "minimum": 0},
              "playout_offset_ms": {"type": "integer", "minimum": 0, "multipleOf": 20},
              "duration_ms": {"const": 20},
              "representation": {"const": "dmr_voice72_air"},
              "bit_length": {"const": 72},
              "payload_hex": {"type": "string", "pattern": "^[0-9A-F]{18}$"},
              "privacy_status": {"enum": ["unknown", "not_indicated", "indicated", "unknown_vendor"]},
              "metadata_revision": {"type": "integer", "minimum": 0},
              "channel_decode_valid": {"type": "boolean"},
              "corrected_bits": {"type": "integer", "minimum": 0},
              "voice_crc_available": {"const": false},
              "erasure": {"const": false},
              "ambe49_hex": {"type": ["string", "null"], "pattern": "^[0-9A-F]{12}(00|80)$"},
              "ambe49_status": {"enum": ["codec_profile_unknown", "privacy_unknown", "opaque_privacy", "opaque_vendor_profile", "unprotected_bits_unverified", "channel_decode_failed", "decrypted_unverified"]},
              "privacy_profile": {"enum": [null, "dmra_arc4", "dmra_aes128", "dmra_aes256", "dmra_des"]},
              "privacy_fid": {"type": ["integer", "null"], "minimum": 0, "maximum": 255},
              "privacy_algorithm_id": {"type": ["integer", "null"], "minimum": 0, "maximum": 255},
              "privacy_key_id": {"type": ["integer", "null"], "minimum": 0, "maximum": 255},
              "privacy_message_indicator": {"type": ["string", "null"], "pattern": "^[0-9A-F]{8}$"},
              "privacy_frame_index": {"type": ["integer", "null"], "minimum": 0, "maximum": 17},
              "cipher49_hex": {"type": ["string", "null"], "pattern": "^[0-9A-F]{12}(00|80)$"},
              "decryption_status": {"enum": ["not_required", "decrypted_unverified", "missing_parameters", "missing_key", "unsupported_profile", "alignment_lost", "invalid_privacy_header", "channel_decode_failed"]}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"type": {"const": "talker_alias"}}},
      "then": {
        "properties": {
          "data": {
            "required": ["source_id", "alias", "format", "declared_length", "blocks_received", "complete", "raw_hex"],
            "properties": {
              "source_id": {"type": ["integer", "null"], "minimum": 0, "maximum": 16777215},
              "alias": {"type": "string"},
              "format": {"enum": ["7bit", "iso8", "utf8", "utf16be"]},
              "declared_length": {"type": "integer", "minimum": 0, "maximum": 31},
              "blocks_received": {"type": "array", "items": {"enum": [0, 1, 2, 3]}, "uniqueItems": true},
              "complete": {"type": "boolean"},
              "raw_hex": {"type": "string", "pattern": "^[0-9A-F]{56}$"},
              "provenance": {"enum": ["embedded_lc", "voice_lc_header", "terminator_lc"]}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"type": {"const": "location"}}},
      "then": {
        "properties": {
          "data": {
            "required": ["latitude", "longitude", "position_error", "source", "source_id", "raw_hex"],
            "properties": {
              "latitude": {"type": "number", "minimum": -90, "maximum": 90},
              "longitude": {"type": "number", "minimum": -180, "maximum": 180},
              "position_error": {"type": ["integer", "null"], "minimum": 0, "maximum": 7},
              "source": {"type": "string"},
              "source_id": {"type": ["integer", "null"], "minimum": 0, "maximum": 16777215},
              "raw_hex": {"type": "string", "pattern": "^[0-9A-F]*$"}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"type": {"const": "data_packet"}}},
      "then": {
        "properties": {
          "data": {
            "required": ["source_id", "destination_id", "group", "sap", "dpf", "confirmed", "rate", "blocks", "crc_valid", "bytes_hex", "complete", "header_hex"],
            "properties": {
              "source_id": {"type": ["integer", "null"], "minimum": 0, "maximum": 16777215},
              "destination_id": {"type": ["integer", "null"], "minimum": 0, "maximum": 16777215},
              "group": {"type": "boolean"},
              "sap": {"type": "integer", "minimum": 0, "maximum": 15},
              "dpf": {"type": "integer", "minimum": 0, "maximum": 15},
              "confirmed": {"type": "boolean"},
              "rate": {"enum": ["half", "three_quarters", "one"]},
              "blocks": {"type": "integer", "minimum": 0},
              "crc_valid": {"type": "boolean"},
              "bytes_hex": {"type": "string", "pattern": "^([0-9A-F]{2})*$"},
              "complete": {"type": "boolean"},
              "header_hex": {"type": "string", "pattern": "^[0-9A-F]{20}$"},
              "blocks_hex": {"type": "string", "pattern": "^([0-9A-F]{2})*$"},
              "application": {"type": ["string", "null"]}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"type": {"const": "text_message"}}},
      "then": {
        "properties": {
          "data": {
            "required": ["source_id", "destination_id", "group", "text", "encoding", "protocol", "port", "crc_valid"],
            "properties": {
              "source_id": {"type": ["integer", "null"], "minimum": 0, "maximum": 16777215},
              "destination_id": {"type": ["integer", "null"], "minimum": 0, "maximum": 16777215},
              "group": {"type": "boolean"},
              "text": {"type": "string"},
              "encoding": {"type": "string"},
              "protocol": {"enum": ["etsi_short_data", "etsi_udt", "motorola_tms", "hytera", "ip_udp_text"]},
              "port": {"type": ["integer", "null"], "minimum": 0, "maximum": 65535},
              "crc_valid": {"type": "boolean"},
              "confidence": {"enum": ["high", "low"]}
            }
          }
        }
      }
    }
  ]
}
